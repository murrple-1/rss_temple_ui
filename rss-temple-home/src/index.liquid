<header class="app--garden app--hero" data-garden="hero">
  <canvas aria-hidden="true"></canvas>
  <div class="app--wrap">
    {% render "nav", env: env %}
    <div class="app--garden-copy">
      <h1>A quiet place. <span>Read what you choose.</span></h1>
      <p>
        RSS Temple collects the sites you follow and shows you what's new. No
        ads, no ranking, no noise.
      </p>
      <a class="app--btn" href="{{ env.web_app_url }}">Begin</a>
    </div>
  </div>
</header>
<main>
  <section class="app--path" id="how-it-works">
    <div class="app--wrap">
      <h2>How it works</h2>
      <ol>
        <li>
          <span class="app--step" aria-hidden="true"><span>1</span></span>
          <h3>Follow</h3>
          <p>Add any site. We'll find its feed.</p>
        </li>
        <li>
          <span class="app--step" aria-hidden="true"><span>2</span></span>
          <h3>Wait</h3>
          <p>New posts arrive on their own.</p>
        </li>
        <li>
          <span class="app--step" aria-hidden="true"><span>3</span></span>
          <h3>Read</h3>
          <p>One at a time, until there are none left.</p>
        </li>
      </ol>
    </div>
  </section>
  <section class="app--closing">
    <div class="app--wrap">
      <blockquote>
        The news will keep coming. Your attention doesn't have to.
      </blockquote>
      <a class="app--btn app--btn-sun" href="{{ env.web_app_url }}"
        >Open RSS Temple</a
      >
    </div>
  </section>
</main>
