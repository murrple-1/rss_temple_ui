<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{{ title }}</title>
{% if description %}
<meta name="description" content="{{ description | escape }}" />
{% endif %}
<meta name="twitter:card" content="summary_large_image" />

<link href="/media/favicon.ico" rel="icon" type="image/x-icon" />
<link href="/media/icon.svg" rel="icon" type="image/svg+xml" />
<meta name="theme-color" content="#e7e4de" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1f1e1c" media="(prefers-color-scheme: dark)" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;600;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
  rel="stylesheet"
  type="text/css"
/>
<link href="/styles/main.min.css" rel="stylesheet" type="text/css" />
{% for additional_link in additional_links %}
<link href="{{ additional_link.href }}" rel="{{ additional_link.rel }}" type="{{ additional_link.type }}" />
{% endfor %}

{{ head_custom_filename | customHtml }}
