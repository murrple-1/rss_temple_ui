---
layout: base.liquid
---
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <symbol id="app--logo" viewBox="0 0 48 48">
      {{ "media/icon.svg" | include | replace: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">', "" | replace: "</svg>", "" }}
    </symbol>
  </defs>
</svg>
{{ content }}
<footer class="app--footer">
  <div class="app--wrap">
    <ul>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/tos/">Terms of Service</a></li>
      <li><a href="/privacy/">Privacy Policy</a></li>
    </ul>
    <ul class="app--social">
      {% if env.fb_url %}
        <li>
          <a href="{{ env.fb_url }}" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
        </li>
      {% endif %}
      {% if env.twitter_x_url %}
        <li>
          <a href="{{ env.twitter_x_url }}" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
        </li>
      {% endif %}
      {% if env.insta_url %}
        <li>
          <a href="{{ env.insta_url }}" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        </li>
      {% endif %}
    </ul>
    <p>&copy; RSS Temple {{ "now" | date: "%Y" }}. All Rights Reserved.</p>
  </div>
</footer>
<script type="module" src="/scripts/main.min.js"></script>
