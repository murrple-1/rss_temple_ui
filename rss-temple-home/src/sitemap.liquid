<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all %}
  {%- assign last_char = entry.url | slice: -1 %}
  {%- if last_char == "/" %}
  <url>
    <loc>{{ env.site_url }}{{ entry.url }}</loc>
  </url>
  {%- endif %}
{%- endfor %}
</urlset>
